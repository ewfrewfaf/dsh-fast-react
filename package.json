{
  "name": "dsh-fast-react",
  "version": "1.6.5",
  "description": "双会话编排：前台快速执行，后台逐步规划。自动判型决定自己干还是交给后台。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/使用须知.md",
    "docs/技术路线.md",
    "docs/移植指南.md",
    "docs/升级验证.md",
    "tools/paths.mjs",
    "tools/selfcheck.mjs",
    "tools/regression.mjs",
    "tools/audit-static.mjs",
    "tools/audit-ui-api.mjs",
    "tools/test-sentinel.mjs",
    "tools/test-route-plan.mjs",
    "tools/test-custom.mjs",
    "tools/test-phases.mjs",
    "tools/test-degrade.mjs",
    "tools/test-handback.mjs",
    "tools/test-overwrite.mjs",
    "tools/test-milestone.mjs",
    "tools/test-mode-intent.mjs",
    "tools/post-restart-smoke.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "orchestration",
    "dual-agent",
    "fast-react",
    "workspace",
    "session-groups"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "console": "/fr",
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ewfrewfaf/dsh-fast-react"
  },
  "homepage": "https://github.com/Ewfrewfaf/dsh-fast-react#readme",
  "icon": "./icon.svg"
}
