{
  "name": "dsh-fast-react",
  "version": "1.5.0",
  "description": "双会话编排：前台快速执行，后台逐步规划。自动判型决定自己干还是交给后台。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "docs",
    "tools",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "orchestration",
    "dual-agent",
    "fast-react",
    "workspace",
    "session-groups"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "console": "/fr",
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ewfrewfaf/dsh-fast-react"
  },
  "homepage": "https://github.com/Ewfrewfaf/dsh-fast-react#readme",
  "icon": "./icon.svg"
}
