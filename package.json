  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "console": "/fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ewfrewfaf/dsh-fast-react"
  },
  "homepage": "https://github.com/Ewfrewfaf/dsh-fast-react#readme"
