    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "orchestration",
    "dual-agent",
    "fast-react",
    "workspace",
    "session-groups"
